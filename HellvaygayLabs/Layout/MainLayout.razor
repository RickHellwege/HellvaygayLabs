@inherits LayoutComponentBase

<style>

    .drawerButton {
        width: 32px;
        height: 32px;
        position: absolute;
        bottom: 0;
        right: 0;
    }

    .drawerButton img {
        display: flex;
        width: 32px;
        height: 32px;
        justify-content: center;
    }

</style>

<TelerikRootComponent>
    <div class="drawer-container">
    <TelerikDrawer Data="@NavigablePages"
                   @bind-Expanded="@DrawerExpanded"
                   MiniMode="false"
                   Mode="@DrawerMode.Overlay"
                   @ref="@DrawerRef">
        <DrawerContent>
            @((MarkupString)@frank)

            @Body
        </DrawerContent>
    </TelerikDrawer>
    </div>

    <TelerikButton Class="drawerButton" OnClick="@ToggleDrawer" FillMode="@ThemeConstants.Button.FillMode.Clear">
        <img src="favicon.png" />
    </TelerikButton>

    @code {
        bool DrawerExpanded { get; set; } = false; // drawer expanded by default
        TelerikDrawer<DrawerItem> DrawerRef { get; set; } = default!; // set by framework

