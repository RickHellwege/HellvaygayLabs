@page "/CampHellGreene"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Camp HellGreene Lake Wedding Reception</PageTitle>

<div class="camp-hellgreene">
    <header class="camp-header">
        <h1 class="camp-title">Camp Hellgreene Lake</h1>
        <p class="camp-subtitle">You're Invited to Survive the Reception</p>
        <p class="camp-date">
            <strong>-Reception Only-</strong>
            Saturday, October 10, 2026 at 5:00 PM
        </p>
        <p class="camp-date">
            <strong>-Full Camp Experience-</strong>
            Friday, October 9 at 3:00 PM - Monday, October 12 at 11:00 AM
        </p>
        <div class="weekend-button-container">
            <button type="button" class="camp-weekend-nav-button" @onclick="NavigateToWeekendPage">
                📅 View Weekend Schedule & Details
            </button>
        </div>
        <p class="camp-note">
            All guests must be 21+
        </p>

    </header>

    <div class="camp-sign">
        <img src="images/CampHellGreeneSign.png" alt="Camp HellGreene Lake Sign" />
    </div>

    <section class="warning-section">
        <div class="warning-box">
            <h2>📵 WARNING 📵</h2>
            <p>There is NO CELL SERVICE at the camp. Print your driving directions and map or you may never escape Route 100...</p>
            <p><em>WiFi available once on camp grounds... if you make it that far.</em></p>
        </div>
    </section>

    <section class="location-section">
        <h2>📍 The Location (If You Dare)</h2>
        <div class="info-box">
            <strong>Bethany Birches Camp</strong><br />
            2610 Lynds Hill Road<br />
            Plymouth, VT 05056
        </div>

    </section>

    <section class="attire-section">
        <h2>👔 Dress Code - Spooky Chic</h2>
        <div class="info-box">
            <p>Cocktail attire, Halloween costume, or a Halloween-cocktail mashup.</p>
            <p>Zombies, vampires, skeletons, and slasher victims in cocktail attire are highly encouraged!</p>
        </div>
    </section>

    <section class="makeup-section">
        <h2>🎨 Special FX Makeup by Jessica Miller</h2>
        <div class="info-box">
            <div class="makeup-profile-section">
                <img src="images/sfxmakeup/Profile.jpg" alt="Jessica Miller - SFX Makeup Artist" class="makeup-profile-img" />
            </div>
            <p>
                Jessica Miller is a talented special effects makeup artist with five years of experience in the haunted house industry, 
                as well as on private photography and film shoots. She'll be stationed at our reception for a few hours to do 
                <strong>complimentary 10-15 minute airbrush makeup looks</strong> for any guests who want a quick, spooky transformation!
            </p>
            <p>
                You can find more of her incredible work on Instagram 
                <a href="https://www.instagram.com/badblood.sfx" target="_blank" class="info-link">@@badblood.sfx</a> 
                Bringing your own inspiration photos from Google or Pinterest is also highly welcome and encouraged.
            </p>
            <div class="makeup-carousel">
                <button class="carousel-btn carousel-btn-prev" @onclick="PreviousImage">‹</button>
                <div class="carousel-container">
                    <img src="@GetCurrentImagePath()" alt="SFX Makeup Example @(currentImageIndex + 1)" class="carousel-img" />
                    <div class="carousel-counter">@(currentImageIndex + 1) / @makeupImages.Count</div>
                </div>
                <button class="carousel-btn carousel-btn-next" @onclick="NextImage">›</button>
            </div>
        </div>

        <div class="info-box">
            <h3>With Jessica, you can live your nightmares and perfect your costume in minutes. Think:</h3>
            <ul class="makeup-options">
                <li><strong>💀 The Skull / Half-Skull Face:</strong> An easy, striking classic.</li>
                <li><strong>🧟 Classic Zombie / Slasher Victim:</strong> Perfect for a high-fashion undead look or pairing with distressed clothing.</li>
                <li><strong>🧙‍♀️ The Witch or Demon:</strong> A fast, vibrant green or deep crimson airbrush base with dark, dramatic shadows that transform your look instantly.</li>
            </ul>
        </div>

        <div class="info-box upgrade-box">
            <h3>Want to go all out? Upgrade available!</h3>
            <p>
                Interested in a more in-depth transformation? You can book a detailed, premium makeup look with Jessica for 
                <strong class="price-highlight">$100</strong> with advance notice. If you would like to purchase and include custom prosthetics, 
                please reach out to us ahead of time so we can coordinate with her!
            </p>
        </div>
    </section>

    <section class="travel-section">
        <h2>🚗 Travel Time</h2>
        
        <div class="travel-info">
            <h3>Drive Time</h3>
            <p>About 3 hours from greater Boston area</p>
            
            <h3>Regional Airports</h3>
            <ul>
                <li><strong>45 minutes:</strong> Rutland Southern Vermont Regional Airport</li>
                <li><strong>2 hours:</strong> Burlington International Airport (NH)</li>
                <li><strong>2.5 hours:</strong> Bradley International Airport (CT)</li>
            </ul>
        </div>
    </section>

    <section class="directions-section">
        <h2>🗺️ Directions (Don't get lost in the woods!)</h2>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("South"))" style="cursor: pointer;">
                From South @(ExpandedDirection == "South" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "South")
            {
                <ol>
                    <li>From Rte 100 after Plymouth, turn right on Rte 100A (Salt Ash Inn is on the corner)</li>
                    <li>Go 0.9 mile and turn right on Lynds Hill Rd</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("East"))" style="cursor: pointer;">
                From East @(ExpandedDirection == "East" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "East")
            {
                <ol>
                    <li>From Rte 4 in Bridgewater, turn left on Rte 100A (general store on the corner)</li>
                    <li>Follow for 6 or 7 miles</li>
                    <li>Make a left on Lynds Hill Rd (sign in fair weather months)</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("West"))" style="cursor: pointer;">
                From West @(ExpandedDirection == "West" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "West")
            {
                <ol>
                    <li>From Rte 4 in Killington, you'll see two general stores after a long straight-away</li>
                    <li>Turn right on Rte 100A</li>
                    <li>Follow for 6 or 7 miles</li>
                    <li>Make a left onto 100A</li>
                    <li>Go 0.9 miles and turn right onto Lynds Hill Rd</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("North"))" style="cursor: pointer;">
                From North @(ExpandedDirection == "North" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "North")
            {
                <ol>
                    <li>From I-89 South, take exit 1 for Woodstock/RT 4</li>
                    <li>Turn West off the exit onto RT 4</li>
                    <li>Take it West through Woodstock into Bridgewater</li>
                    <li>In Bridgewater Corners, make a left at the general store onto 100A</li>
                    <li>Follow for 6 or 7 miles</li>
                    <li>Make a left on Lynds Hill Rd (sign in fair weather months)</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>
    </section>

    <section class="rsvp-section">
        <h2>📝 RSVP</h2>
        <div class="rsvp-content">
            <p>RSVPs are now closed. Thank you for your interest!</p>
        </div>
    </section>


    <footer class="camp-footer">
        <p>🌲 We can't wait to see you at Camp HellGreene! 🌲</p>
        <p><em>No actual murders planned... probably.</em></p>
    </footer>
</div>

@code {

    private string? ExpandedDirection { get; set; } = null;

    private void ToggleDirection(string direction)
    {
        ExpandedDirection = ExpandedDirection == direction ? null : direction;
    }

    private int currentImageIndex = 0;
    private List<string> makeupImages = new List<string>
    {
        "images/sfxmakeup/1.jpg",
        "images/sfxmakeup/2.jpg",
        "images/sfxmakeup/3.jpg",
        "images/sfxmakeup/4.jpg",
        "images/sfxmakeup/5.jpg",
        "images/sfxmakeup/6.jpg",
        "images/sfxmakeup/7.jpg",
        "images/sfxmakeup/8.jpg",
        "images/sfxmakeup/9.jpg",
        "images/sfxmakeup/10.jpg",
        "images/sfxmakeup/11.jpg",
        "images/sfxmakeup/12.jpg",
        "images/sfxmakeup/13.jpg",
        "images/sfxmakeup/14.jpg",
        "images/sfxmakeup/15.jpg",
        "images/sfxmakeup/16.jpg"
    };
    private System.Threading.Timer? carouselTimer;

    protected override void OnInitialized()
    {
        // Start auto-rotation timer (5 seconds)
        carouselTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                NextImage();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private string GetCurrentImagePath()
    {
        return makeupImages[currentImageIndex];
    }

    private void NextImage()
    {
        currentImageIndex = (currentImageIndex + 1) % makeupImages.Count;
    }

    private void PreviousImage()
    {
        currentImageIndex = (currentImageIndex - 1 + makeupImages.Count) % makeupImages.Count;
    }

    private void NavigateToWeekendPage()
    {
        Navigation.NavigateTo("/CampHellGreene/Weekend");
    }

    public void Dispose()
    {
        carouselTimer?.Dispose();
    }

}
