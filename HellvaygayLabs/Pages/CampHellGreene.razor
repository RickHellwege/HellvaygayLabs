@page "/CampHellGreene"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http

<link rel="stylesheet" href="css/camphellgreene.css" />

<PageTitle>Camp HellGreene Lake Wedding Reception</PageTitle>

<div class="camp-hellgreene">
    <header class="camp-header">
        <h1 class="camp-title">Camp Hellgreene Lake</h1>
        <p class="camp-subtitle">You're Invited to Survive the Reception</p>
        <p class="camp-date">
            <strong>-Reception Only-</strong>
            Saturday, October 10, 2026 at 5:00 PM
        </p>
        <p class="camp-date">
            <strong>-Full Camp Experience-</strong>
            Friday, October 9 at 3:00 PM - Monday, October 12 at 11:00 AM
        </p>
        <p class="camp-note camp-rsvp-note">
            Don't forget to RSVP at the bottom of the page.
        </p>
        <p class="camp-note">
            All guests must be 21+
        </p>

    </header>

    <div class="camp-sign">
        <img src="images/CampHellGreeneSign.png" alt="Camp HellGreene Lake Sign" />
    </div>

    <section class="adventure-section">
        <h2>🧭 Choose Your Own Adventure</h2>
        <div class="adventure-grid">
            <a href="/CampHellGreene#local-accommodations" class="adventure-box">
                <h3>Reception Only</h3>
                <p>Stay off-site and join us Saturday at 5PM for Reception</p>
            </a>
            <a href="/CampHellGreene#sleepaway-section" class="adventure-box">
                <h3>Weekend Camp Experience</h3>
                <p>Stay on-site at Bethany Birch for a weekend of thrills, chills, and surprises.</p>
            </a>
        </div>
    </section>

    <section class="warning-section">
        <div class="warning-box">
            <h2>📵 WARNING 📵</h2>
            <p>There is NO CELL SERVICE at the camp. Print your driving directions and map or you may never escape Route 100...</p>
            <p><em>WiFi available once on camp grounds... if you make it that far.</em></p>
        </div>
    </section>

    <section class="location-section">
        <h2>📍 The Location (If You Dare)</h2>
        <div class="info-box">
            <strong>Bethany Birches Camp</strong><br />
            2610 Lynds Hill Road<br />
            Plymouth, VT 05056
        </div>

    </section>

    <section class="local-accommodations" id="local-accommodations">
        <h2>🏨 Local Accommodations</h2>
        <p class="accommodations-intro">Hotels ordered by distance from Camp Bethany Birch:</p>
        
        <div class="hotel-grid">
            <div class="hotel-card">
                <h3>Killington Mountain Lodge</h3>
                <p class="hotel-collection">Tapestry Collection by Hilton</p>
                <p class="hotel-distance">~10.5 miles</p>
                <a href="https://killingtonmountainlodge.com" target="_blank" class="hotel-link">killingtonmountainlodge.com</a>
            </div>

            <div class="hotel-card">
                <h3>The Vermont Inn</h3>
                <p class="hotel-distance">~13.3 miles</p>
                <a href="https://vermontinn.com" target="_blank" class="hotel-link">vermontinn.com</a>
            </div>

            <div class="hotel-card">
                <h3>Jackson Gore Inn</h3>
                <p class="hotel-collection">at Okemo Mountain Resort</p>
                <p class="hotel-distance">~14.5 miles</p>
                <a href="https://okemo.com/jackson-gore-inn" target="_blank" class="hotel-link">okemo.com/jackson-gore-inn</a>
            </div>

            <div class="hotel-card">
                <h3>Mountain Lodge at Okemo</h3>
                <p class="hotel-distance">~15.0 miles</p>
                <a href="https://okemo.com/mountain-lodge" target="_blank" class="hotel-link">okemo.com/mountain-lodge</a>
            </div>

            <div class="hotel-card">
                <h3>Okemo Mountain Resort</h3>
                <p class="hotel-distance">~15.0 miles</p>
                <a href="https://okemo.com" target="_blank" class="hotel-link">okemo.com</a>
            </div>

            <div class="hotel-card">
                <h3>The Governor's Inn</h3>
                <p class="hotel-distance">~15.5 miles</p>
                <a href="https://thegovernorsinn.com" target="_blank" class="hotel-link">thegovernorsinn.com</a>
            </div>
        </div>
        <p class="lodging-warning">
            <strong>⚠️ Book Lodging ASAP!</strong><br />
            October is peak foliage season on the Route 100 Scenic Byway.<br />
            Hotels are selling out fast... don't get stuck in the woods!
        </p>
    </section>

    <section class="sleepaway-section" id="sleepaway-section">
        <h2>🏕️ Grown Up Sleepaway Camp</h2>
        <p class="camp-dates"><strong>Friday, October 9 at 3:00 PM - Monday, October 12 at 11:00 AM</strong></p>
        <p class="camp-subtitle-text">Indigenous People's Day Weekend</p>
        
        <div class="info-box">
            <h3>Cabin Details</h3>
            <ul>
                <li>Heated cabin at an off-season summer camp</li>
                <li>Sleeps up to 32 brave souls</li>
                <li>Twin beds in shared rooms and lofts</li>
                <li>Includes clean blanket, pillow, and pillow case</li>
                <li>2 indoor bathrooms + bathhouse on grounds</li>
                <li>Kitchen and basement rec room</li>
            </ul>
            
            <h3>What to Bring</h3>
            <ul>
                <li>🛏️ BYO bedding and towels</li>
                <li>🎒 Your survival kit (just kidding... or are we?)</li>
            </ul>
            
            <div class="cost-box">
                <strong>Costs:</strong>
                <p>Full Weekend (food, activities, beer, & wine, and bed in cabin) $150</p>
                <p>Full Weekend (food, activities, beer, & wine only. No bed    )  $75</p>
            </div>
        </div>
    </section>

    <section class="activities-section">
        <h2>🎯 Survival Activities</h2>
        <div class="activities-grid">
            <div class="activity-card">🔥 Nightly Bonfires<br /><small>Gourmet SMORES Station</small></div>
            <div class="activity-card">🍺 Drinking<br /><small>Beer & wine allowed. Liquor only at reception with licensed bartender</small></div>
            <div class="activity-card">🧗 Indoor Rock Climbing<small>One day only</small></div>
            <div class="activity-card">🎲 Board Games<small>Small library and BYO</small></div>
            <div class="activity-card">🚣 Lake Activities<br/><small>Boats, kayaks, water slide, water trampoline (weather permitting)</small></div>
            <div class="activity-card">🥾 Hiking Trails</div>
            <div class="activity-card">🗺️ GPS Scavenger Hunt</div>
            <div class="activity-card">🎯 Self-Defense Training<small>Archery, hatchet throwing, and slingshot target practice.</small></div>
            <div class="activity-card">🌙 Midnight Woods Walk<br/><small>Redlight only</small></div>
            <div class="activity-card">🔦 Flashlight Tag</div>
        </div>
    </section>

    <section class="travel-section">
        <h2>🚗 Travel Time</h2>
        
        <div class="travel-info">
            <h3>Drive Time</h3>
            <p>About 3 hours from greater Boston area</p>
            
            <h3>Regional Airports</h3>
            <ul>
                <li><strong>45 minutes:</strong> Rutland Southern Vermont Regional Airport</li>
                <li><strong>2 hours:</strong> Burlington International Airport (NH)</li>
                <li><strong>2.5 hours:</strong> Bradley International Airport (CT)</li>
            </ul>
        </div>
    </section>

    <section class="directions-section">
        <h2>🗺️ Directions (Don't get lost in the woods!)</h2>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("South"))" style="cursor: pointer;">
                From South @(ExpandedDirection == "South" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "South")
            {
                <ol>
                    <li>From Rte 100 after Plymouth, turn right on Rte 100A (Salt Ash Inn is on the corner)</li>
                    <li>Go 0.9 mile and turn right on Lynds Hill Rd</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("East"))" style="cursor: pointer;">
                From East @(ExpandedDirection == "East" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "East")
            {
                <ol>
                    <li>From Rte 4 in Bridgewater, turn left on Rte 100A (general store on the corner)</li>
                    <li>Follow for 6 or 7 miles</li>
                    <li>Make a left on Lynds Hill Rd (sign in fair weather months)</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("West"))" style="cursor: pointer;">
                From West @(ExpandedDirection == "West" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "West")
            {
                <ol>
                    <li>From Rte 4 in Killington, you'll see two general stores after a long straight-away</li>
                    <li>Turn right on Rte 100A</li>
                    <li>Follow for 6 or 7 miles</li>
                    <li>Make a left onto 100A</li>
                    <li>Go 0.9 miles and turn right onto Lynds Hill Rd</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>

        <div class="direction-box">
            <h3 @onclick="@(() => ToggleDirection("North"))" style="cursor: pointer;">
                From North @(ExpandedDirection == "North" ? "▼" : "▶")
            </h3>
            @if (ExpandedDirection == "North")
            {
                <ol>
                    <li>From I-89 South, take exit 1 for Woodstock/RT 4</li>
                    <li>Turn West off the exit onto RT 4</li>
                    <li>Take it West through Woodstock into Bridgewater</li>
                    <li>In Bridgewater Corners, make a left at the general store onto 100A</li>
                    <li>Follow for 6 or 7 miles</li>
                    <li>Make a left on Lynds Hill Rd (sign in fair weather months)</li>
                    <li>Go 2.6 miles on the twisting, country road</li>
                    <li>Bethany Birches Camp is on your right and is clearly marked</li>
                    <li>The cabin is on your right as you enter the parking lot</li>
                </ol>
            }
        </div>
    </section>

    <section class="rsvp-section">
        <h2>📝 RSVP</h2>
        <div class="rsvp-content">
            <p>Let us know if you'll be joining us at Camp HellGreene!</p>
            <button @onclick="ToggleWindowVisibility" class="rsvp-button">Click Here to RSVP</button>
        </div>
    </section>

    <TelerikWindow Modal="true" @bind-Visible="@IsVisible">
        <WindowTitle>
            <strong>RSVP</strong>
        </WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" />
        </WindowActions>
        <WindowContent>
            <TelerikForm Model="@rsvp" OnValidSubmit="@OnValidSubmitHandler">
                <FormValidation>
                    <DataAnnotationsValidator />
                </FormValidation>
                <FormItems>
                    <FormItem Field="@nameof(RSVP.Name)" LabelText="Name" />
                    <FormItem Field="@nameof(RSVP.Email)" LabelText="Email" />
                    <FormItem Field="@nameof(RSVP.Message)" LabelText="Message (optional)" />
                    <FormItem Field="@nameof(RSVP.Answer)">
                        <Template>
                            <label for="firsttime" class="k-label k-form-label">RSVP Selection</label>
                            <div class="k-form-field-wrap">
                                <TelerikRadioGroup Data="@RadioGroupData" @bind-Value="@rsvp.Answer" />
                                <TelerikValidationMessage For="@(() => rsvp.Answer)" />
                            </div>
                        </Template>
                    </FormItem>

                </FormItems>
            </TelerikForm>

        </WindowContent>

    </TelerikWindow>

    <TelerikDialog @bind-Visible="@ShowConfirmation"
                   Title="Success!"
                   Width="500px">
        <DialogContent>
            <div class="confirmation-content">
                <p>RSVP Submitted Successfully!</p>
            </div>
        </DialogContent>
        <DialogButtons>
            <button class="confirmation-button" @onclick="@(() => ShowConfirmation = false)">OK</button>
        </DialogButtons>
    </TelerikDialog>

    <TelerikDialog @bind-Visible="@ShowError"
                   Title="Error"
                   Width="500px">
        <DialogContent>
            <div class="error-content">
                <p>Please try again later or call Rick</p>
            </div>
        </DialogContent>
        <DialogButtons>
            <button class="error-button" @onclick="@(() => ShowError = false)">OK</button>
        </DialogButtons>
    </TelerikDialog>

    <footer class="camp-footer">
        <p>🌲 We can't wait to see you at Camp HellGreene! 🌲</p>
        <p><em>No actual murders planned... probably.</em></p>
    </footer>
</div>

@code {

    private bool IsVisible { get; set; } = false;
    private bool ShowConfirmation { get; set; } = false;
    private bool ShowError { get; set; } = false;
    private string? ExpandedDirection { get; set; } = null;

    private void ToggleWindowVisibility()
    {
        IsVisible = !IsVisible;
    }

    private void ToggleDirection(string direction)
    {
        ExpandedDirection = ExpandedDirection == direction ? null : direction;
    }

    private async Task OnValidSubmitHandler()
    {
        // Send data to your API
        var response = await Http.PostAsJsonAsync("https://formspree.io/f/mdalvvpa", rsvp);

        if (response.IsSuccessStatusCode)
        {
            // Handle successful submission (e.g., show a success message, redirect)
            Console.WriteLine("Form submitted successfully!");
            rsvp = new RSVP(); // Clear the form
            IsVisible = false; // Close the window
            ShowConfirmation = true; // Show confirmation dialog
        }
        else
        {
            // Handle error
            Console.WriteLine($"Error submitting form: {response.StatusCode}");
            rsvp = new RSVP(); // Clear the form
            IsVisible = false; // Close the window
            ShowError = true; // Show error dialog
        }
    }


    private IEnumerable<string> RadioGroupData { get; set; } = new List<string> {
        "Not Attending",
        "Attending - Reception Only",
        "Attending - Full Weekend (Food & Activities)",
        "Attending - Full Weekend (Food, Activities, & Bed)"};


    public RSVP rsvp = new RSVP();

    public class RSVP
    {
        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; }

        [Required(ErrorMessage = "Email is required")]
        [RegularExpression(@"^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|net|org)$",
                       ErrorMessage = "Email must be a valid .com, .net, or .org address.")]
        public string Email { get; set; }

        public string Message { get; set; }

        [Required(ErrorMessage = "RSVP Selection is required")]
        public string Answer { get; set; }
    }
}
