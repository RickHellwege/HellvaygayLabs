@page "/CampHellGreene"

<PageTitle>Camp HellGreene Wedding Reception</PageTitle>

<div class="camp-hellgreene">
    <header class="camp-header">
        <h1 class="camp-title">⚠️ CAMP HELLGREENE ⚠️</h1>
        <p class="camp-subtitle">You're Invited to Survive the Reception</p>
        <p class="camp-date">Saturday, October 10, 2026 at 5:00 PM</p>
    </header>

    <section class="warning-section">
        <div class="warning-box">
            <h2>🔪 WARNING 🔪</h2>
            <p>There is NO CELL SERVICE at the camp. Print your driving directions and map or you may never escape Route 100...</p>
            <p><em>WiFi available once on camp grounds... if you make it that far.</em></p>
        </div>
    </section>

    <section class="location-section">
        <h2>📍 The Location (If You Dare)</h2>
        <div class="info-box">
            <strong>Bethany Birches Camp</strong><br />
            2610 Lynds Hill Road<br />
            Plymouth, VT 05056
        </div>
        <p class="lodging-warning">
            <strong>⚠️ Book Lodging ASAP!</strong><br />
            Stay in Killington or Plymouth, VT. October is peak foliage season on the Route 100 Scenic Byway.<br />
            Hotels are selling out fast... don't get stuck in the woods!
        </p>
    </section>

    <section class="sleepaway-section">
        <h2>🏕️ Grown Up Sleepaway Camp</h2>
        <p class="camp-dates"><strong>Friday, October 9 at 3:00 PM - Monday, October 12 at 11:00 AM</strong></p>
        <p class="camp-subtitle-text">Indigenous People's Day Weekend</p>
        
        <div class="info-box">
            <h3>Cabin Details</h3>
            <ul>
                <li>Heated cabin at an off-season summer camp</li>
                <li>Sleeps up to 32 brave souls</li>
                <li>Twin beds in shared rooms and lofts</li>
                <li>Includes clean blanket, pillow, and pillow case</li>
                <li>2 indoor bathrooms + bathhouse on grounds</li>
                <li>Kitchen and basement rec room</li>
            </ul>
            
            <h3>What to Bring</h3>
            <ul>
                <li>🛏️ BYO bedding and towels</li>
                <li>🎒 Your survival kit (just kidding... or are we?)</li>
            </ul>
            
            <div class="cost-box">
                <strong>Cost:</strong> $150 for the weekend, meals included
            </div>
        </div>
    </section>

    <section class="activities-section">
        <h2>🎯 Survival Activities</h2>
        <div class="activities-grid">
            <div class="activity-card">🎲 Board Games</div>
            <div class="activity-card">🧗 Indoor Rock Climbing (one day only)</div>
            <div class="activity-card">🚣 Pond Activities<br/><small>Boats, kayaks, water slide, water trampoline (weather permitting)</small></div>
            <div class="activity-card">🥾 Hiking Trails</div>
            <div class="activity-card">🥏 Frisbee Golf</div>
            <div class="activity-card">⚽ Tetherball</div>
            <div class="activity-card">🏀 Basketball Court<br/><small>Balls and nets provided</small></div>
            <div class="activity-card">🔥 Campfires</div>
            <div class="activity-card">🍺 Drinking<br/><small>Beer & wine allowed. Liquor only at reception with licensed bartender</small></div>
        </div>
    </section>

    <section class="travel-section">
        <h2>🚗 Getting to Camp (Don't Get Lost!)</h2>
        
        <div class="travel-info">
            <h3>Drive Time</h3>
            <p>About 3 hours from greater Boston area</p>
            
            <h3>Airports</h3>
            <ul>
                <li><strong>45 minutes:</strong> Rutland Southern Vermont Regional Airport</li>
                <li><strong>2 hours:</strong> Burlington International Airport (NH)</li>
                <li><strong>2.5 hours:</strong> Bradley International Airport (CT)</li>
            </ul>
        </div>
    </section>

    <section class="directions-section">
        <h2>🗺️ Directions (You May Think You're Lost... But You Aren't!)</h2>
        
        <div class="direction-box">
            <h3>From South</h3>
            <ol>
                <li>From Rte 100 after Plymouth, turn right on Rte 100A (Salt Ash Inn is on the corner)</li>
                <li>Go 0.9 mile and turn right on Lynds Hill Rd</li>
                <li>Go 2.6 miles on the twisting, country road</li>
                <li>Bethany Birches Camp is on your right and is clearly marked</li>
                <li>The cabin is on your right as you enter the parking lot</li>
            </ol>
        </div>

        <div class="direction-box">
            <h3>From East</h3>
            <ol>
                <li>From Rte 4 in Bridgewater, turn left on Rte 100A (general store on the corner)</li>
                <li>Follow for 6 or 7 miles</li>
                <li>Make a left on Lynds Hill Rd (sign in fair weather months)</li>
                <li>Go 2.6 miles on the twisting, country road</li>
                <li>Bethany Birches Camp is on your right and is clearly marked</li>
                <li>The cabin is on your right as you enter the parking lot</li>
            </ol>
        </div>

        <div class="direction-box">
            <h3>From West</h3>
            <ol>
                <li>From Rte 4 in Killington, you'll see two general stores after a long straight-away</li>
                <li>Turn right on Rte 100A</li>
                <li>Follow for 6 or 7 miles</li>
                <li>Make a left onto 100A</li>
                <li>Go 0.9 miles and turn right onto Lynds Hill Rd</li>
                <li>Go 2.6 miles on the twisting, country road</li>
                <li>Bethany Birches Camp is on your right and is clearly marked</li>
                <li>The cabin is on your right as you enter the parking lot</li>
            </ol>
        </div>

        <div class="direction-box">
            <h3>From North</h3>
            <ol>
                <li>From I-89 South, take exit 1 for Woodstock/RT 4</li>
                <li>Turn West off the exit onto RT 4</li>
                <li>Take it West through Woodstock into Bridgewater</li>
                <li>In Bridgewater Corners, make a left at the general store onto 100A</li>
                <li>Follow for 6 or 7 miles</li>
                <li>Make a left on Lynds Hill Rd (sign in fair weather months)</li>
                <li>Go 2.6 miles on the twisting, country road</li>
                <li>Bethany Birches Camp is on your right and is clearly marked</li>
                <li>The cabin is on your right as you enter the parking lot</li>
            </ol>
        </div>
    </section>

    <footer class="camp-footer">
        <p>🌲 We can't wait to see you at Camp HellGreene! 🌲</p>
        <p><em>No actual murders planned... probably.</em></p>
    </footer>
</div>

<style>
.camp-hellgreene {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    background-color: #0d1b0d;
    color: #d4d4d4;
    font-family: 'Courier New', monospace;
    height: auto;
    overflow-y: auto;
    min-height: 100%;
}

    .camp-header {
        text-align: center;
        padding: 40px 20px;
        background: linear-gradient(135deg, #1a0000 0%, #330000 100%);
        border: 3px solid #8b0000;
        margin-bottom: 30px;
        box-shadow: 0 0 20px rgba(139, 0, 0, 0.5);
    }

    .camp-title {
        font-size: 3em;
        color: #ff0000;
        text-shadow: 3px 3px 6px #000;
        margin: 0;
        letter-spacing: 5px;
        animation: flicker 3s infinite;
    }

    @@keyframes flicker {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.8; }
        75% { opacity: 0.9; }
    }

    .camp-subtitle {
        font-size: 1.5em;
        color: #fff;
        margin: 10px 0;
    }

    .camp-date {
        font-size: 1.2em;
        color: #ffcccc;
        margin: 10px 0;
        font-weight: bold;
    }

    .warning-section {
        margin: 30px 0;
    }

    .warning-box {
        background-color: #4a1010;
        border: 3px solid #ff0000;
        padding: 20px;
        text-align: center;
        box-shadow: 0 0 15px rgba(255, 0, 0, 0.3);
    }

    .warning-box h2 {
        color: #ff0000;
        font-size: 2em;
        margin-top: 0;
    }

    .warning-box p {
        color: #fff;
        font-size: 1.1em;
    }

    section {
        margin: 40px 0;
        padding: 20px;
        background-color: #1a2b1a;
        border: 2px solid #3d5c3d;
        border-radius: 5px;
    }

    h2 {
        color: #ff6666;
        font-size: 2em;
        border-bottom: 2px solid #8b0000;
        padding-bottom: 10px;
        margin-top: 0;
    }

    h3 {
        color: #ff9999;
        font-size: 1.5em;
        margin-top: 20px;
    }

    .info-box {
        background-color: #2a3a2a;
        padding: 20px;
        border-left: 5px solid #ff6666;
        margin: 20px 0;
    }

    .info-box ul {
        list-style-type: none;
        padding-left: 0;
    }

    .info-box li {
        padding: 8px 0;
        border-bottom: 1px solid #3d5c3d;
    }

    .info-box li:last-child {
        border-bottom: none;
    }

    .cost-box {
        background-color: #4a1010;
        color: #ffcc00;
        padding: 15px;
        margin-top: 20px;
        text-align: center;
        font-size: 1.3em;
        border: 2px solid #ffcc00;
    }

    .lodging-warning {
        background-color: #4a3000;
        color: #ffd700;
        padding: 15px;
        margin-top: 15px;
        border: 2px dashed #ffd700;
        text-align: center;
    }

    .camp-dates {
        font-size: 1.2em;
        color: #ffcc99;
        text-align: center;
    }

    .camp-subtitle-text {
        text-align: center;
        color: #b8b8b8;
        font-style: italic;
    }

    .activities-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .activity-card {
        background-color: #2a3a2a;
        padding: 20px;
        text-align: center;
        border: 2px solid #3d5c3d;
        border-radius: 5px;
        transition: all 0.3s;
        font-size: 1.1em;
    }

    .activity-card:hover {
        background-color: #3a4a3a;
        border-color: #ff6666;
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(255, 102, 102, 0.3);
    }

    .travel-info {
        background-color: #2a3a2a;
        padding: 20px;
        border-radius: 5px;
    }

    .travel-info ul {
        list-style-type: none;
        padding-left: 0;
    }

    .travel-info li {
        padding: 10px 0;
        border-bottom: 1px solid #3d5c3d;
    }

    .direction-box {
        background-color: #2a3a2a;
        padding: 20px;
        margin: 20px 0;
        border-left: 5px solid #ff9999;
    }

    .direction-box ol {
        padding-left: 20px;
    }

    .direction-box li {
        padding: 8px 0;
        line-height: 1.6;
    }

    .camp-footer {
        text-align: center;
        padding: 40px 20px;
        background-color: #1a0000;
        border: 2px solid #8b0000;
        margin-top: 40px;
        font-size: 1.2em;
    }

    .camp-footer p {
        margin: 10px 0;
    }

    .camp-footer em {
        color: #ff6666;
        font-size: 0.9em;
    }

    @@media (max-width: 768px) {
        .camp-title {
            font-size: 2em;
            letter-spacing: 2px;
        }

        .activities-grid {
            grid-template-columns: 1fr;
        }

        section {
            padding: 15px;
        }
    }
</style>

